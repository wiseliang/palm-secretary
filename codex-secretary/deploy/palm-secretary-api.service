[Unit]
Description=Palm Secretary Codex API
After=network-online.target mihomo.service
Wants=network-online.target

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/opt/palm-secretary/current
EnvironmentFile=/etc/palm-secretary/app.env
Environment=HOME=/home/codex
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/node dist-server/index.js
Restart=on-failure
RestartSec=4
TimeoutStopSec=20
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=false
ProtectHome=false
ProtectKernelTunables=false
ProtectKernelModules=false
ProtectControlGroups=false
RestrictSUIDSGID=false
LockPersonality=true
UMask=0077
MemoryMax=1800M
TasksMax=512

[Install]
WantedBy=multi-user.target

{
  "name": "palm-secretary",
  "version": "0.13.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vinext build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "vinext start",
    "start:api": "node dist-server/index.js",
    "password:hash": "tsx server/hash-password.ts",
    "check": "npm run build:server && eslint . --ignore-pattern dist --ignore-pattern dist-server --ignore-pattern .next",
    "test:integration": "node tests/integration-v02.mjs",
    "test:v08": "node tests/resume-share-v08.mjs",
    "test:v09": "node tests/inline-image-focus-v09.mjs",
    "test:v010": "node tests/visual-system-v010.mjs",
    "test:v012": "node tests/stability-v012.mjs",
    "test:v013": "node tests/audit-complete-v013.mjs",
    "test:v014": "node tests/design-system-v014.mjs",
    "test:v015": "node tests/safety-regressions-v015.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-server --ignore-pattern .next"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/websocket": "^11.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "fastify": "^5.12.1",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
